#!/usr/bin/env python3
"""Apply Omarchy's resolved palette to local applications; --setup opts them in."""
import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib


def write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.read_text() == content:
        return
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as file:
        file.write(content)
    os.replace(file.name, path)


def backup(path):
    if path.exists():
        dest = Path.home() / '.local/state/dotfiles-backups' / datetime.now().strftime('omarchy-%Y%m%d-%H%M%S')
        dest.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, dest / (path.parent.name + '-' + path.name))


def rgb(color):
    return [int(color[i:i + 2], 16) for i in (1, 3, 5)]


def mix(left, right, amount):
    return '#' + ''.join(f'{round(a + (b - a) * amount):02x}' for a, b in zip(rgb(left), rgb(right)))


def luminance(color):
    channels = [value / 255 for value in rgb(color)]
    return sum(weight * (c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4)
               for weight, c in zip((0.2126, 0.7152, 0.0722), channels))


def contrast(left, right):
    first, second = sorted((luminance(left), luminance(right)))
    return (second + .05) / (first + .05)


def readable(color, backgrounds, minimum=4.5):
    target = '#000000' if luminance(backgrounds[0]) > 0.179 else '#ffffff'
    for step in range(21):
        candidate = mix(color, target, step / 20)
        if all(contrast(candidate, bg) >= minimum for bg in backgrounds):
            return candidate
    return target


def semantic_colors(palette, backgrounds):
    colors = {}
    for token, source, fallback in [
        ('green', 'green', '#98bb6c'), ('yellow', 'yellow', '#e6c384'),
        ('red', 'red', '#e06c75'), ('blue', 'blue', '#7e9cd8'),
        ('teal', 'cyan', '#7fb4ca'), ('peach', 'orange', '#ffa066'),
        ('mauve', 'magenta', '#b49cde'),
    ]:
        if palette['mode'] == 'light':
            fallback = {
                'green': '#416c21', 'yellow': '#825a00', 'red': '#aa2f37',
                'blue': '#2868a0', 'teal': '#256d89', 'peach': '#a34715',
                'mauve': '#754599',
            }[token]
        color = next((palette[key] for key in (source, 'bright_' + source)
                      if key in palette and max(rgb(palette[key])) - min(rgb(palette[key])) >= 40), fallback)
        color = readable(color, backgrounds)
        if max(rgb(color)) - min(rgb(color)) < 40:
            color = readable(fallback, backgrounds)
        colors[token] = color
    return colors


def sync_herdr(config, palette):
    path = config / 'herdr/config.toml'
    if not path.exists():
        return
    text = path.read_text()
    # Only manage hosts explicitly opted in by --setup.
    if tomllib.loads(text).get('theme', {}).get('name') != 'terminal':
        return
    bg, fg = palette['background'], palette['foreground']
    active, selection = mix(bg, fg, .10), mix(bg, fg, .30)
    backgrounds = [bg, active, selection]
    custom = {
        'panel_bg': bg, 'sidebar_bg': bg, 'active_row_bg': active,
        'selection_bg': selection, 'surface0': active, 'surface1': selection,
        'surface_dim': active, 'text': readable(fg, backgrounds),
        'overlay0': readable(palette['muted'], backgrounds),
        'overlay1': readable(fg, backgrounds),
        'subtext0': readable(palette['dark_foreground'], backgrounds),
        'accent': readable(palette['accent'], backgrounds),
    }
    custom.update(semantic_colors(palette, backgrounds))
    section = re.search(r'(?ms)^\[theme\.custom\][^\n]*\n(.*?)(?=^\[|\Z)', text)
    body = section.group(1) if section else ''
    for key, value in custom.items():
        entry = f'{key} = "{value}"'
        pattern = rf'(?m)^{key}\s*=.*$'
        body = re.sub(pattern, entry, body) if re.search(pattern, body) else body.rstrip() + '\n' + entry + '\n'
    if section:
        text = text[:section.start(1)] + body.rstrip() + '\n\n' + text[section.end(1):]
    else:
        text += '\n# Colors managed by omarchy-sync-apps.\n[theme.custom]\n' + body.strip() + '\n\n'
    tomllib.loads(text)
    write(path, text)


def k9s_palette(palette):
    colors = dict(palette)
    bg = palette['background']
    accents = semantic_colors(palette, [bg])
    for key, source in [('red', 'red'), ('green', 'green'), ('yellow', 'yellow'),
                        ('blue', 'blue'), ('cyan', 'teal'), ('magenta', 'mauve'), ('orange', 'peach')]:
        colors[key] = accents[source]
    for key in ('accent', 'muted'):
        colors[key] = readable(palette[key], [bg])
    colors['foreground'] = readable(palette['foreground'], [bg], minimum=7)
    # k9s 0.51 replaces the selected background with the row's status color.
    # All status colors contrast with bg, so bg is the safe selected foreground.
    colors['selection_foreground'] = bg
    colors['selection_background'] = colors['accent']
    return colors


def zed_theme(palette):
    bg, fg = palette['background'], palette['foreground']
    raised, hover, selected = mix(bg, fg, .06), mix(bg, fg, .10), mix(bg, fg, .16)
    line = mix(bg, fg, .05)
    backgrounds = [bg, raised, selected]
    text = readable(fg, backgrounds, minimum=7)
    muted = readable(mix(bg, fg, .6), backgrounds)
    disabled = mix(bg, fg, .4)
    border = mix(bg, fg, .14)
    accent = readable(palette['accent'], backgrounds)
    # The same accent fallbacks as Neovim keep monochrome themes' syntax distinct.
    c = semantic_colors(palette, [bg, line])
    comment = readable(palette['muted'], [bg, line])
    selection = palette['selection_background']
    if contrast(selection, bg) < 1.25:
        selection = mix(bg, accent, .35)

    def a(color, amount):
        return color + f'{round(amount * 255):02x}'

    style = {
        'background.appearance': 'opaque',
        'background': bg, 'surface.background': bg, 'elevated_surface.background': raised,
        'border': border, 'border.variant': mix(bg, fg, .10), 'border.focused': accent,
        'border.selected': accent, 'border.transparent': '#00000000', 'border.disabled': mix(bg, fg, .10),
        'element.background': raised, 'element.hover': hover, 'element.active': selected,
        'element.selected': selected, 'element.disabled': raised,
        'drop_target.background': a(accent, .2),
        'ghost_element.background': '#00000000', 'ghost_element.hover': hover,
        'ghost_element.active': selected, 'ghost_element.selected': selected,
        'ghost_element.disabled': '#00000000',
        'text': text, 'text.muted': muted, 'text.placeholder': disabled, 'text.disabled': disabled,
        'text.accent': accent, 'icon': text, 'icon.muted': muted, 'icon.placeholder': disabled,
        'icon.disabled': disabled, 'icon.accent': accent, 'debugger.accent': c['red'],
        'status_bar.background': bg, 'title_bar.background': bg, 'title_bar.inactive_background': bg,
        'toolbar.background': bg, 'tab_bar.background': bg, 'tab.inactive_background': bg,
        'tab.active_background': raised, 'panel.background': bg, 'panel.focused_border': accent,
        'panel.indent_guide': border, 'panel.indent_guide_hover': disabled,
        'panel.indent_guide_active': disabled, 'pane.focused_border': accent,
        'pane_group.border': border,
        'search.match_background': a(accent, .35), 'search.active_match_background': a(c['peach'], .45),
        'scrollbar.thumb.background': a(fg, .15), 'scrollbar.thumb.hover_background': a(fg, .25),
        'scrollbar.thumb.active_background': a(fg, .35), 'scrollbar.thumb.border': '#00000000',
        'scrollbar.track.background': '#00000000', 'scrollbar.track.border': '#00000000',
        'minimap.thumb.background': a(fg, .15), 'minimap.thumb.hover_background': a(fg, .25),
        'minimap.thumb.active_background': a(fg, .35), 'minimap.thumb.border': '#00000000',
        'editor.foreground': text, 'editor.background': bg, 'editor.gutter.background': bg,
        'editor.subheader.background': raised, 'editor.active_line.background': line,
        'editor.highlighted_line.background': line,
        'editor.debugger_active_line.background': a(c['yellow'], .15),
        'editor.line_number': readable(palette['muted'], [bg, line], minimum=3),
        'editor.active_line_number': text, 'editor.hover_line_number': muted,
        'editor.invisible': mix(bg, fg, .25), 'editor.wrap_guide': mix(bg, fg, .08),
        'editor.active_wrap_guide': border, 'editor.indent_guide': mix(bg, fg, .08),
        'editor.indent_guide_active': mix(bg, fg, .2),
        'editor.document_highlight.read_background': a(accent, .15),
        'editor.document_highlight.write_background': a(accent, .25),
        'editor.document_highlight.bracket_background': a(accent, .25),
        'editor.diff_hunk.added.background': a(c['green'], .16),
        'editor.diff_hunk.added.hollow_background': a(c['green'], .06),
        'editor.diff_hunk.added.hollow_border': a(c['green'], .4),
        'editor.diff_hunk.deleted.background': a(c['red'], .16),
        'editor.diff_hunk.deleted.hollow_background': a(c['red'], .06),
        'editor.diff_hunk.deleted.hollow_border': a(c['red'], .4),
        'version_control.added': c['green'], 'version_control.modified': c['blue'],
        'version_control.deleted': c['red'], 'version_control.renamed': c['teal'],
        'version_control.conflict': c['peach'], 'version_control.ignored': disabled,
        'version_control.word_added': a(c['green'], .3), 'version_control.word_deleted': a(c['red'], .3),
        'version_control.conflict_marker.ours': a(c['green'], .16),
        'version_control.conflict_marker.theirs': a(c['blue'], .16),
        'link_text.hover': c['blue'],
        # Omarchy's terminals use the palette unchanged, so Zed's does too.
        'terminal.background': bg, 'terminal.ansi.background': bg, 'terminal.foreground': fg,
        'terminal.bright_foreground': palette['bright_foreground'], 'terminal.dim_foreground': muted,
    }
    for index, name in enumerate(['black', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan', 'white']):
        style[f'terminal.ansi.{name}'] = palette[f'color{index}']
        style[f'terminal.ansi.bright_{name}'] = palette[f'color{index + 8}']
        style[f'terminal.ansi.dim_{name}'] = mix(bg, palette[f'color{index}'], .7)
    for status, color in [
        ('error', c['red']), ('warning', c['yellow']), ('info', c['blue']), ('hint', c['teal']),
        ('success', c['green']), ('created', c['green']), ('modified', c['blue']),
        ('deleted', c['red']), ('renamed', c['teal']), ('conflict', c['peach']),
        ('hidden', disabled), ('ignored', disabled), ('unreachable', muted), ('predictive', muted),
    ]:
        style.update({status: color, status + '.background': mix(bg, color, .12),
                      status + '.border': mix(bg, color, .35)})
    for mode, color in [('normal', accent), ('insert', c['green']), ('replace', c['red']),
                        ('visual', c['mauve']), ('visual_line', c['mauve']), ('visual_block', c['mauve']),
                        ('helix_normal', accent), ('helix_select', c['mauve'])]:
        style[f'vim.{mode}.background'] = color
        style[f'vim.{mode}.foreground'] = bg
    style['vim.yank.background'] = a(c['yellow'], .3)
    style['accents'] = [c[key] for key in ('blue', 'mauve', 'teal', 'yellow', 'peach', 'green', 'red')]
    style['players'] = [{'cursor': palette['cursor'], 'background': palette['cursor'], 'selection': selection}] + [
        {'cursor': c[key], 'background': c[key], 'selection': a(c[key], .25)}
        for key in ('blue', 'mauve', 'peach', 'teal', 'yellow', 'red', 'green')]
    # Mirrors mini.base16's groups in Neovim, without italics.
    syntax = {
        'attribute': c['yellow'], 'boolean': c['peach'], 'comment': comment, 'comment.doc': comment,
        'constant': c['peach'], 'constructor': c['yellow'], 'embedded': text, 'enum': c['yellow'],
        'function': c['blue'], 'hint': muted, 'keyword': c['mauve'], 'label': c['yellow'],
        'link_text': c['blue'], 'link_uri': c['teal'], 'number': c['peach'], 'operator': text,
        'predictive': muted, 'preproc': c['yellow'], 'primary': text, 'property': c['red'],
        'punctuation': muted, 'punctuation.bracket': muted, 'punctuation.delimiter': muted,
        'punctuation.list_marker': c['red'], 'punctuation.special': c['teal'], 'string': c['green'],
        'string.escape': c['teal'], 'string.regex': c['teal'], 'string.special': c['teal'],
        'string.special.symbol': c['teal'], 'tag': c['yellow'], 'text.literal': c['green'],
        'title': c['blue'], 'type': c['yellow'], 'variable': text, 'variable.special': c['red'],
        'variant': c['peach'], 'emphasis': c['mauve'], 'emphasis.strong': c['peach'],
    }
    style['syntax'] = {key: {'color': color} for key, color in syntax.items()}
    for key in ('title', 'emphasis.strong'):
        style['syntax'][key]['font_weight'] = 700
    return {
        '$schema': 'https://zed.dev/schema/themes/v0.2.0.json',
        'name': 'Omarchy', 'author': 'omarchy-sync-apps',
        'themes': [{'name': 'Omarchy', 'appearance': palette['mode'], 'style': style}],
    }


def setup(config):
    import yaml

    # Herdr has no conditional config includes. Replace the local symlink with
    # a host copy, leaving its portable source in dotfiles unchanged.
    herdr = config / 'herdr/config.toml'
    text = herdr.read_text() if herdr.exists() else ''
    section = re.search(r'(?ms)^\[theme\][^\n]*\n(.*?)(?=^\[|\Z)', text)
    if section:
        body = section.group(1)
        if re.search(r'(?m)^name\s*=', body):
            body = re.sub(r'(?m)^name\s*=.*$', 'name = "terminal"', body)
        else:
            body = 'name = "terminal"\n' + body
        # Explicitly keep the terminal palette through light/dark transitions.
        body = re.sub(r'(?m)^auto_switch\s*=.*$', 'auto_switch = false', body)
        text = text[:section.start(1)] + body + text[section.end(1):]
    else:
        text += '\n[theme]\nname = "terminal"\n'
    tomllib.loads(text)
    backup(herdr)
    write(herdr, text)

    k9s = config / 'k9s/config.yaml'
    settings = yaml.safe_load(k9s.read_text()) if k9s.exists() else {}
    settings = settings or {}
    ui = settings.setdefault('k9s', {}).setdefault('ui', {})
    ui.update(skin='omarchy', reactive=True)
    backup(k9s)
    write(k9s, yaml.safe_dump(settings, sort_keys=False))

    # Zed settings are JSON with comments, so edit only the theme entry.
    zed = config / 'zed/settings.json'
    if zed.parent.is_dir():
        text = zed.read_text() if zed.exists() else '{\n}\n'
        entry = '"theme": "Omarchy"'
        pattern = r'"theme"\s*:\s*(\{[^{}]*\}|"[^"]*")'
        if re.search(pattern, text):
            text = re.sub(pattern, entry, text, count=1)
        else:
            text = re.sub(r'\{', '{\n  ' + entry + ',', text, count=1)
        backup(zed)
        write(zed, text)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--setup', action='store_true')
    args = parser.parse_args()
    home = Path.home()
    colors = home / '.local/state/omarchy/current/theme/colors.toml'
    if sys.platform != 'linux' or not shutil.which('omarchy-theme-color') or not colors.is_file():
        return
    config = home / '.config'
    if args.setup:
        setup(config)
    output = subprocess.check_output(['omarchy-theme-color', '--file', str(colors), '--all'], text=True)
    palette = dict(line.split('\t', 1) for line in output.splitlines())
    templates = config / 'omarchy/app-templates'
    tmux = home / '.local/state/omarchy/apps/tmux.conf'
    for name, dest in [('k9s.yaml', config / 'k9s/skins/omarchy.yaml'), ('tmux.conf', tmux)]:
        app_palette = k9s_palette(palette) if name == 'k9s.yaml' else palette
        template = (templates / (name + '.tpl')).read_text()
        def replace(match):
            value = app_palette[match.group(1)]
            if not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
                raise ValueError(f'Invalid color: {match.group(1)}')
            return value
        write(dest, re.sub(r'\{\{ (\w+) \}\}', replace, template))
    sync_herdr(config, palette)
    if (config / 'zed').is_dir():
        # Zed watches its themes directory and reapplies the active theme.
        theme = json.dumps(zed_theme(palette), indent=2) + '\n'
        for value in re.findall(r'"(#[^"]*)"', theme):
            if not re.fullmatch(r'#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?', value):
                raise ValueError(f'Invalid Zed color: {value}')
        write(config / 'zed/themes/omarchy.json', theme)
    if shutil.which('tmux') and subprocess.run(['tmux', 'list-sessions'], capture_output=True).returncode == 0:
        subprocess.run(['tmux', 'source-file', str(tmux)], check=True)
    if shutil.which('herdr'):
        # Also repaints connected clients; a stopped server is normal.
        result = subprocess.run(['herdr', 'server', 'reload-config'], capture_output=True, text=True, timeout=10)
        if result.returncode and args.setup:
            print('Herdr will use its terminal theme on next launch.', file=sys.stderr)


if __name__ == '__main__':
    main()
