#!/bin/sh
# Git clean filter for the Herdr app layout (see .gitattributes). Resets what Herdr
# and the tabs-keys mod rewrite while it runs: the side panel's shown state. Real
# layout edits still reach git.
exec jq '
  (.. | objects | select(.id == "panel") | .hidden) = true
  | (.. | objects | select(.id == "panel-body") | .active) = "changes"
'
